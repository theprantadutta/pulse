  "typography": {
    "family": "Roboto Flex (variable; axes used: wght, wdth, opsz)",
    "file": "fonts/RobotoFlex-Variable.ttf",
    "numerals": "tabular figures everywhere (FontFeature.tabularFigures())",
    "scale": {
      "hero": {
        "size": 104,
        "weight": 900,
        "wdth": 120,
        "lineHeight": 0.95,
        "tracking": -0.04,
        "use": "live latency inside the hero cookie"
      },
      "display": {
        "size": 76,
        "weight": 900,
        "wdth": 125,
        "lineHeight": 0.9,
        "tracking": -0.04,
        "use": "summary numbers (traceroute total)"
      },
      "headlineL": {
        "size": 40,
        "weight": 800,
        "wdth": 125,
        "lineHeight": 1.05,
        "tracking": -0.02,
        "use": "top-level screen titles (Ping, Network, Tools, History)"
      },
      "headlineM": {
        "size": 28,
        "weight": 800,
        "wdth": 115,
        "lineHeight": 1.1,
        "tracking": -0.01,
        "use": "pane titles on tablet"
      },
      "titleL": {
        "size": 22,
        "weight": 700,
        "wdth": 100,
        "lineHeight": 1.2,
        "use": "app bar titles on detail screens"
      },
      "titleM": {
        "size": 16,
        "weight": 600,
        "wdth": 100,
        "lineHeight": 1.3,
        "use": "list headlines, card titles"
      },
      "bodyM": {
        "size": 14,
        "weight": 400,
        "wdth": 100,
        "lineHeight": 1.4
      },
      "bodyS": {
        "size": 13,
        "weight": 400,
        "wdth": 100,
        "lineHeight": 1.35,
        "use": "supporting text"
      },
      "labelM": {
        "size": 12,
        "weight": 600,
        "wdth": 100,
        "lineHeight": 1.3
      },
      "overline": {
        "size": 11,
        "weight": 700,
        "wdth": 100,
        "tracking": 0.1,
        "transform": "uppercase"
      },
      "numberM": {
        "size": 20,
        "weight": 800,
        "wdth": 110,
        "use": "list trailing values, stats"
      }
    }
  },
  "shape": {
    "radius": {
      "xs": 6,
      "sm": 12,
      "md": 16,
      "lg": 20,
      "xl": 28,
      "xxl": 32,
      "full": 999
    },
    "segmentedList": {
      "outer": 24,
      "inner": 6,
      "gap": 3
    },
    "connectedButtonGroup": {
      "outer": 24,
      "inner": 8,
      "gap": 3,
      "selectedFlex": 1.35
    },
    "family": {
      "cookie12": {
        "scallops": 12,
        "depth": 0.1
      },
      "cookie9": {
        "scallops": 9,
        "depth": 0.11
      },
      "cookie7": {
        "scallops": 7,
        "depth": 0.12
      },
      "cookie4": {
        "scallops": 4,
        "depth": 0.09
      },
      "clover4": {
        "scallops": 4,
        "depth": 0.2
      },
      "clover8": {
        "scallops": 8,
        "depth": 0.14
      },
      "sunny": {
        "scallops": 10,
        "depth": 0.08
      },
      "burst": {
        "scallops": 12,
        "depth": 0.16
      },
      "flower": {
        "scallops": 8,
        "depth": 0.22
      },
      "formula": "r(θ) = R + A·cos(n·θ); A = outerRadius·depth; R = outerRadius − A; start at 12 o'clock"
    }
  },
  "spacing": {
    "unit": 4,
    "screenGutterPhone": 16,
    "screenGutterTablet": 24,
    "sectionGap": 12,
    "listGap": 3,
    "touchTargetMin": 48,
    "safeTopPhone": 40
  },
  "layout": {
    "phone": {
      "width": 390,
      "height": 844,
      "navigationBar": 80,
      "appBar": 64,
      "appBarLarge": 72
    },
    "tablet": {
      "width": 1280,
      "height": 800,
      "navigationRail": 96,
      "listPane": 300,
      "breakpoints": {
        "compact": "<600",
        "medium": "600–839 (rail, single pane)",
        "expanded": "≥840 (rail + list-detail)"
      }
    }
  },
  "elevation": {
    "dark": {
      "level3": "0 8 24 rgba(0,0,0,.38)"
    },
    "light": {
      "level3": "0 8 22 rgba(70,20,45,.18)"
    },
    "note": "Use tonal surfaces for hierarchy; shadows only on FAB and floating elements."
  },
  "motion": {
    "easing": {
      "spring": [
        0.3,
        1.4,
        0.5,
        1.0
      ],
      "emphasized": [
        0.2,
        0.0,
        0.0,
        1.0
      ],
      "emphasizedDecelerate": [
        0.05,
        0.7,
        0.1,
        1.0
      ],
      "standard": [
        0.2,
        0.0,
        0.0,
        1.0
      ]
    },
    "springs_approx": {
      "spatialFast": {
        "stiffness": 800,
        "dampingRatio": 0.6
      },
      "spatialDefault": {
        "stiffness": 380,
        "dampingRatio": 0.8
      },
      "spatialSlow": {
        "stiffness": 200,
        "dampingRatio": 0.8
      },
      "effectsDefault": {
        "stiffness": 1600,
        "dampingRatio": 1.0
      },
      "note": "Approximation of Material 3 Expressive motion scheme; verify on m3.material.io."
    },
    "durations_ms": {
      "press": 200,
      "chip": 450,
      "enter": 600,
      "stagger": 40,
      "barGrow": 600,
      "ecgLoop": 2400,
      "breathe": 1200,
      "heroSpin": 28000,
      "smallSpin": 10000,
      "morph": 9000,
      "sonar": 2000,
      "waveTravel": 1100,
      "packetTravel": 2600,
      "liveTick": 1000
    }
  }
}