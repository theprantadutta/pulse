**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment Variables
.env
# Kotlin compiler daemon sessions
android/.kotlin/

# Code-signing material (kept in %USERPROFILE%\.pulse-signing, never in the repo)
*.pfx
*.cer

# Firebase config (generated by `flutterfire configure`, kept out of the repo)
firebase.json
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist

# App key for the Pulse API (see lib/services/pulse_api.dart); same value as the backend .env.
secrets.json
